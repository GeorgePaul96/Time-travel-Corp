[gd_scene load_steps=2 format=3 uid="uid://dashboard"]

[ext_resource type="Script" path="res://scripts/ui/dashboard.gd" id="1_dash"]

[node name="Dashboard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_dash")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/separation = 8

[node name="ResourceStrip" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 60)
theme_override_constants/separation = 8

[node name="HSeparator" type="HSeparator" parent="VBoxContainer"]
layout_mode = 2

[node name="MainArea" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="LeftPanel" type="VBoxContainer" parent="VBoxContainer/MainArea"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="StatsHeader" type="Label" parent="VBoxContainer/MainArea/LeftPanel"]
layout_mode = 2
text = "-- CORPORATION STATUS --"

[node name="StatGrid" type="GridContainer" parent="VBoxContainer/MainArea/LeftPanel"]
layout_mode = 2
columns = 2

[node name="LogHeader" type="Label" parent="VBoxContainer/MainArea/LeftPanel"]
layout_mode = 2
text = "-- OPERATIONS LOG --"

[node name="OpsLog" type="RichTextLabel" parent="VBoxContainer/MainArea/LeftPanel"]
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
scroll_active = true
text = "[no entries yet]"

[node name="RightPanel" type="VBoxContainer" parent="VBoxContainer/MainArea"]
layout_mode = 2
custom_minimum_size = Vector2(200, 0)
theme_override_constants/separation = 8

[node name="MissionsHeader" type="Label" parent="VBoxContainer/MainArea/RightPanel"]
layout_mode = 2
text = "-- ACTIVE MISSIONS --"

[node name="MissionList" type="VBoxContainer" parent="VBoxContainer/MainArea/RightPanel"]
layout_mode = 2
size_flags_vertical = 3
