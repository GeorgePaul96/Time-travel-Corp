; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but the file format is well-documented in the Godot docs.

config_version=5

[application]

config/name="Time Travel Corp"
config/run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoloads/game_state.gd"
AgentManager="*res://autoloads/agent_manager.gd"
EraManager="*res://autoloads/era_manager.gd"
ResearchManager="*res://autoloads/research_manager.gd"
EventManager="*res://autoloads/event_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"

[gui]

theme/custom="res://theme/terminal.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0313726, 0.0509804, 0.0313726, 1)
